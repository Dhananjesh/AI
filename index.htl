<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Free AI Chat</title>
  <style>
    * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
    body { margin: 0; background: #0f172a; color: #f8fafc; display: flex; flex-direction: column; height: 100vh; }
    header { background: #1e293b; padding: 14px 20px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center; border-bottom: 1px solid #334155; }
    header h1 { margin: 0; font-size: 1.1rem; margin-right: auto; }
    input, select, button { padding: 8px 12px; border-radius: 8px; border: 1px solid #475569; background: #0f172a; color: #f8fafc; font-size: 0.9rem; }
    button { background: #3b82f6; border: none; font-weight: 600; cursor: pointer; }
    button:hover { background: #2563eb; }
    button:disabled { background: #475569; cursor: not-allowed; }
    #chat { flex: 1; overflow-y: auto; padding: 20px; display: flex; flex-direction: column; gap: 12px; max-width: 800px; width: 100%; margin: 0 auto; }
    .msg { padding: 12px 16px; border-radius: 12px; max-width: 80%; line-height: 1.5; white-space: pre-wrap; }
    .user { background: #2563eb; align-self: flex-end; }
    .ai { background: #1e293b; border: 1px solid #334155; align-self: flex-start; }
    .error { background: #7f1d1d; border: 1px solid #ef4444; align-self: center; font-size: 0.85rem; }
    footer { background: #1e293b; padding: 14px 20px; border-top: 1px solid #334155; }
    .input-row { max-width: 800px; margin: 0 auto; display: flex; gap: 10px; }
    #prompt { flex: 1; }
  </style>
</head>
<body>
  <header>
    <h1>⚡ My GitHub AI Chat</h1>
    <input type="password" id="token" placeholder="Paste ghp_ token here..." />
    <select id="model">
      <option value="openai/gpt-4o-mini">GPT-4o mini (Fast)</option>
      <option value="meta/meta-llama-3.1-8b-instruct">Llama 3.1 8B</option>
      <option value="mistral-ai/mistral-small-2503">Mistral Small</option>
      <option value="deepseek/deepseek-r1">DeepSeek R1</option>
    </select>
  </header>

  <div id="chat">
    <div class="msg ai">Hi! Paste your GitHub token at the top, pick a model, and ask me anything.</div>
  </div>

  <footer>
    <div class="input-row">
      <input type="text" id="prompt" placeholder="Type a message..." onkeydown="if(event.key==='Enter') sendMessage()" />
      <button id="sendBtn" onclick="sendMessage()">Send</button>
    </div>
  </footer>

  <script>
    const chat = document.getElementById("chat");
    const history = [];

    function addBubble(text, type) {
      const div = document.createElement("div");
      div.className = "msg " + type;
      div.textContent = text;
      chat.appendChild(div);
      chat.scrollTop = chat.scrollHeight;
      return div;
    }

    async function sendMessage() {
      const token = document.getElementById("token").value.trim();
      const model = document.getElementById("model").value;
      const promptInput = document.getElementById("prompt");
      const sendBtn = document.getElementById("sendBtn");
      const text = promptInput.value.trim();

      if (!token) return addBubble("Please paste your ghp_ token in the top bar first.", "error");
      if (!text) return;

      addBubble(text, "user");
      history.push({ role: "user", content: text });
      promptInput.value = "";
      sendBtn.disabled = true;

      const loading = addBubble("Thinking...", "ai");

      try {
        const res = await fetch("https://github.ai", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
          },
          body: JSON.stringify({ model, messages: history })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error?.message || "HTTP " + res.status);

        const reply = data.choices[0].message.content;
        loading.textContent = reply;
        history.push({ role: "assistant", content: reply });
      } catch (err) {
        loading.className = "msg error";
        loading.textContent = "Error: " + err.message;
      } finally {
        sendBtn.disabled = false;
        promptInput.focus();
      }
    }
  </script>
</body>
</html>
